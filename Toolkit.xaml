<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows PC Toolkit" Width="1200" Height="860" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#10151E" Foreground="#E7ECF5" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#233044"/><Setter Property="Foreground" Value="#E7ECF5"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#88B5FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="#17202D"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#17202D"/><Setter Property="Foreground" Value="#182030"/>
      <Setter Property="RowBackground" Value="#E9EEF6"/><Setter Property="AlternatingRowBackground" Value="#DCE5F2"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeight" Value="34"/><Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9B7CE"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E7ECF5"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  </Window.Resources>
  <Grid Background="#10151E">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#17202D" Padding="20,26">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
          <TextBlock Text="PC TOOLKIT" FontWeight="Bold" FontSize="21"/>
          <TextBlock Text="Windows · v3.0.0" Foreground="#7E94B2" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Portable. Local. No account." Foreground="#7E94B2" FontSize="12" Margin="0,0,0,12"/>
          <Button Name="DuckLink" Content="Explore optimizerDuck" Style="{StaticResource Navigation}" ToolTip="Open the recommended open-source Windows optimizer on GitHub"/>
          <Button Name="SourceLink" Content="Toolkit on GitHub" Style="{StaticResource Navigation}"/>
        </StackPanel>
        <StackPanel>
          <Button Name="NavOptimize" Content="Optimize" Style="{StaticResource Navigation}" Background="#315FA0"/>
          <Button Name="NavStartup" Content="Startup &amp; tasks" Style="{StaticResource Navigation}"/>
          <Button Name="NavApps" Content="App debloat" Style="{StaticResource Navigation}"/>
          <Button Name="NavDns" Content="Encrypted DNS" Style="{StaticResource Navigation}"/>
          <Button Name="NavRecovery" Content="Recovery &amp; reports" Style="{StaticResource Navigation}"/>
          <Button Name="NavTools" Content="Repair &amp; tools" Style="{StaticResource Navigation}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Name="OptimizePage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Optimize Windows for gaming" Style="{StaticResource Heading}"/>
          <TextBlock Text="One-click gaming, cleanup, registry repair and Copilot/consumer debloat. Preview or customize before applying." Style="{StaticResource Description}"/>
          <Border Background="#19283D" Padding="16,12" CornerRadius="7" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Name="HardwareText" Text="Windows 10/11 · Hardware details load after startup" FontWeight="SemiBold"/>
              <TextBlock Text="Update services, security, Store, Xbox, game dependencies and drivers stay available." Foreground="#9FB5D2" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
          <Button Name="OptimizeButton" Content="Optimize now" Background="#68A8FF" Foreground="#10151E" FontWeight="SemiBold" Padding="28,12"/>
          <Button Name="PreviewButton" Content="Preview changes"/>
          <Button Name="RecommendedButton" Content="Reset selections"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Name="OptionsPanel"/></ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,12,0,12">
          <CheckBox Name="IncludeReviewed" Content="Also apply my selected startup entries and app removals" IsChecked="False" ToolTip="Select rows in Startup and App debloat first. They can be included in this same one-click operation and recovery report."/>
          <TextBlock Text="App removals are named before confirmation. Package/settings backups support undo; deleted app data, Recall snapshots and temp files are not restored." Foreground="#7E94B2" FontSize="12"/>
        </StackPanel>
      </Grid>
      <Grid Name="StartupPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Startup apps &amp; scheduled tasks" Style="{StaticResource Heading}"/><TextBlock Text="Choose what launches at boot. Microsoft tasks are kept out of this list. Ctrl-click to select several rows. Undo is available in Recovery." Style="{StaticResource Description}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><Button Name="RefreshStartup" Content="Refresh list"/><Button Name="DisableStartup" Content="Disable selected"/></StackPanel>
        <DataGrid Grid.Row="2" Name="StartupGrid" SelectionMode="Extended">
          <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Command" Binding="{Binding Target}" Width="*"/></DataGrid.Columns>
        </DataGrid>
      </Grid>
      <Grid Name="AppsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Remove optional consumer apps" Style="{StaticResource Heading}"/><TextBlock Text="Review installed apps from a curated list. Store, Xbox, Gaming Services, WebView and Windows components are protected. Removal affects this user's app data; backups support package reinstall." Style="{StaticResource Description}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><Button Name="RefreshApps" Content="Refresh list"/><Button Name="RemoveApps" Content="Remove selected apps"/></StackPanel>
        <DataGrid Grid.Row="2" Name="AppsGrid" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="160"/></DataGrid.Columns></DataGrid>
      </Grid>
      <Grid Name="DnsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Encrypted DNS" Style="{StaticResource Heading}"/><TextBlock Text="Choose one provider for a physical network adapter. HTTPS encryption has no plaintext fallback. A failed verification restores your previous DNS configuration." Style="{StaticResource Description}"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,24">
          <TextBlock Text="Network adapter" Margin="0,0,0,8"/>
          <ComboBox Name="AdapterCombo" DisplayMemberPath="Name" Height="36" Margin="0,0,0,16"/>
          <TextBlock Text="Provider" Margin="0,0,0,8"/>
          <ComboBox Name="ProviderCombo" DisplayMemberPath="Name" Height="36"/>
        </StackPanel>
        <WrapPanel Grid.Row="2"><Button Name="ApplyDns" Content="Apply encrypted DNS" Background="#68A8FF" Foreground="#10151E"/><Button Name="VerifyDns" Content="Verify"/><Button Name="RestoreDns" Content="Restore previous"/><Button Name="DhcpDns" Content="Use automatic DNS"/><Button Name="RefreshDns" Content="Refresh adapters" Margin="0,10,0,0"/></WrapPanel>
        <TextBlock Grid.Row="3" Text="Mullvad public encrypted DNS ends November 2, 2026; new applies have been removed. Existing backups remain restorable. Choose Quad9 or AdGuard for ongoing service.&#10;&#10;DoH encrypts DNS queries. VPN routing, public IP, browsers and unrelated adapters retain their own configuration. IPv4 and IPv6 automatic/static modes are saved separately." Foreground="#9FB5D2" Margin="0,24,0,0"/>
      </Grid>
      <Grid Name="RecoveryPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Recovery &amp; operation reports" Style="{StaticResource Heading}"/><TextBlock Text="Restore a selected operation. Each report records what was applied or failed. Registry values changed since optimization are preserved and reported for review." Style="{StaticResource Description}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><Button Name="RefreshHistory" Content="Refresh history"/><Button Name="UndoButton" Content="Undo selected operation"/><Button Name="OpenReport" Content="Open report"/><Button Name="OpenBackups" Content="Open backup folder"/></StackPanel>
        <DataGrid Grid.Row="2" Name="HistoryGrid" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="210"/><DataGridTextColumn Header="Operation" Binding="{Binding Mode}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid>
      <Grid Name="ToolsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Repair, diagnostics &amp; advanced tools" Style="{StaticResource Heading}"/><TextBlock Text="Use repair for a fault, and diagnostics to compare your PC before and after changes. Windows repair runs DISM first, then SFC. No forced reboot." Style="{StaticResource Description}"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Windows health" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,22"><Button Name="RepairButton" Content="Repair Windows (DISM + SFC)"/><Button Name="RestorePointButton" Content="Create restore point"/><Button Name="HealthButton" Content="Refresh system health"/></WrapPanel>
          <TextBlock Text="Toolkit consoles" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,22"><Button Name="OpenFixer" Content="Corruption Fixer"/><Button Name="OpenCleaner" Content="PC Cleaner / registry review"/><Button Name="OpenPrivacy" Content="Privacy Guard"/><Button Name="OpenGaming" Content="GPU, HAGS, VR &amp; game session"/><Button Name="OpenDns" Content="DNS diagnostics console" Margin="0,10,0,0"/></WrapPanel>
          <TextBlock Text="Windows controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,22"><Button Name="SettingsUpdates" Content="Windows Update"/><Button Name="SettingsDisplay" Content="Display &amp; refresh rate"/><Button Name="SettingsPower" Content="Power"/><Button Name="SettingsStorage" Content="Storage Sense"/><Button Name="SettingsApps" Content="Installed apps" Margin="0,10,0,0"/></WrapPanel>
          <TextBlock Text="Essential services" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <DataGrid Name="ServicesGrid" Height="190"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Startup" Binding="{Binding StartMode}" Width="160"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="160"/></DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="1" Background="#192330" CornerRadius="7" Padding="14" Margin="0,16,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Name="StatusText" Text="Ready · Recommended selections are enabled" Foreground="#B8CBE5"/>
          <ProgressBar Name="BusyBar" Grid.Row="1" Height="3" Margin="0,10,0,0" Visibility="Collapsed" IsIndeterminate="True" Foreground="#68A8FF"/>
          <TextBox Name="ResultText" Grid.Row="2" Height="110" Margin="0,12,0,0" Visibility="Collapsed" Background="#10151E" Foreground="#D7E4F7" BorderThickness="0" Padding="8" FontSize="12" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
